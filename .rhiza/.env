# .rhiza/.env — project-local environment overrides (optional)
#
# This file is optional.  If absent, rhiza.mk falls back to built-in defaults:
#   SOURCE_FOLDER     = src
#   MARIMO_FOLDER     = docs/notebooks
#   RHIZA_CI_OS_MATRIX = ["ubuntu-latest"]
#
# Add or uncomment only the variables you want to override.
# Variables defined here are exported to all Make recipes.

MARIMO_FOLDER=docs/notebooks
SOURCE_FOLDER=src
# ty only. mypy --strict spends its findings on polars' and altair's own union-typed
# signatures — every `float(series.mean())` and every chained `.encode()` — which says
# nothing about this code. Note the default `both` masks ty's exit code behind mypy's,
# so this is also the only setting under which ty's findings actually gate.
TYPECHECKER=ty
RHIZA_CI_OS_MATRIX=["ubuntu-latest","macos-latest","windows-latest"]
